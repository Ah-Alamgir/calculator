<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScientificCalculatorAI" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/btn_sci_bg</item>
        <item name="colorPrimaryVariant">@color/lcd_bezel_dark</item>
        <item name="colorOnPrimary">@color/text_btn_white</item>
        <item name="android:statusBarColor">@color/calc_body_white</item>
        <item name="android:navigationBarColor">@color/calc_body_white</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/calc_body_white</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <!-- Top Scientific Function Key Style -->
    <style name="CalcSciButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_btn_sci</item>
        <item name="android:textColor">@color/text_btn_white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <!-- Bottom Main Keypad Number/Operator Button Style -->
    <style name="CalcNumButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_btn_num</item>
        <item name="android:textColor">@color/text_btn_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <!-- Coral/Red DEL and AC Button Style -->
    <style name="CalcDelAcButton" parent="CalcNumButton">
        <item name="android:background">@drawable/bg_btn_del_ac</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
