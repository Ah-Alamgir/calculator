<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/btn_replay_pad_pressed" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/btn_replay_stroke" />
                </shape>
            </item>
            <item
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp">
                <shape android:shape="oval">
                    <solid android:color="@color/btn_replay_pad_pressed" />
                    <stroke
                        android:width="1dp"
                        android:color="#AEB5C2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/btn_replay_pad_outer" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/btn_replay_stroke" />
                </shape>
            </item>
            <item
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp">
                <shape android:shape="oval">
                    <solid android:color="@color/btn_replay_pad_inner" />
                    <stroke
                        android:width="1dp"
                        android:color="#B8BFCC" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
